{
  "id": "spotify",
  "name": "Spotify",
  "version": "1.0.0",
  "description": "Play and browse Spotify beside your work.",
  "run": ["kero", "plugin-run", "spotify"],
  "widgets": [
    {
      "name": "player",
      "title": "Spotify",
      "minWidth": 280,
      "minHeight": 150,
      "compact": {
        "minWidth": 280,
        "minHeight": 150
      }
    }
  ],
  "commands": [
    { "id": "play-pause", "title": "Play or Pause" },
    { "id": "next", "title": "Next Track" },
    { "id": "previous", "title": "Previous Track" },
    { "id": "sign-out", "title": "Sign Out of Spotify" }
  ],
  "permissions": ["secrets", "openURL", "web", "ambient"],
  "settings": [
    {
      "key": "clientId",
      "label": "Client ID",
      "kind": "text",
      "secret": false,
      "help": "Your Spotify app's Client ID. Add http://127.0.0.1:43017/callback as the app's redirect URI.",
      "link": "https://developer.spotify.com/dashboard"
    },
    {
      "key": "sign-out",
      "label": "Sign Out",
      "kind": "action",
      "help": "Forget the Spotify sign-in. The Client ID stays, so signing in again is one press."
    }
  ]
}
